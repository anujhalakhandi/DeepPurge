#!/sbin/sh
# Standard Magisk module installer stub (KernelSU and APatch don't need it)
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || { ui_print "! Please install from the root manager app"; exit 1; }
. /data/adb/magisk/util_functions.sh
install_module
exit 0
